+# v23.8-fix4: Android 16 Live Updates (the status-bar chip with the song name) need this non-runtime
+# permission, otherwise the system refuses to promote the notification. On older Android it is
+# simply an unknown permission and is ignored.
+if "POST_PROMOTED_NOTIFICATIONS" not in t:
+    m = re.search(r'<uses-permission\b[^>]*?/>', t)
+    perm = '\n    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>'
+    if m:
+        t = t[:m.end()] + perm + t[m.end():]
+    else:
+        m = re.search(r'<application\b', t)
+        assert m, "<application> not found in manifest"
+        t = t[:m.start()] + perm.lstrip("\n") + "\n    " + t[m.start():]
